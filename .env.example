# Copy to .env and fill in. Never commit .env.
XAI_API_KEY=
XAI_MODEL=grok-4.3
# live | record | replay. Blank = live when XAI_API_KEY is set, otherwise replay.
# record serves responses already in fixtures/llm_cache/ and calls Grok (saving the response) for the rest.
LLM_MODE=
INVENTORY_DB=inventory.db
# Optional LangSmith tracing (no code changes needed)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
